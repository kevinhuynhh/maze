<%- include('partials/header', { isAdmin }) %>
<section class="container py-5">
  <div class="row g-4">
    <div class="col-lg-7">
      <p class="badge text-bg-success">Membership</p>
      <h1 class="h3 fw-bold">Tham gia thư viện prompt printable</h1>
      <p class="text-muted">
        Nhận toàn bộ prompt, template workshop, file in ấn với một membership duy nhất. Admin phát
        hành, cập nhật hàng tuần.
      </p>
      <div class="row g-3">
        <div class="col-md-6">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <h2 class="h4">Starter</h2>
              <p class="text-muted">Dành cho cá nhân làm nội dung, coach nhỏ.</p>
              <p class="fs-4 fw-bold text-primary">$19 / tháng</p>
              <ul class="list-unstyled text-muted">
                <li>✔️ Truy cập toàn bộ prompt printable</li>
                <li>✔️ Tải xuống PDF, PNG, Notion template</li>
                <li>✔️ Cập nhật 2 lần/tháng</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card h-100 shadow-sm border-primary">
            <div class="card-body">
              <h2 class="h4">Agency</h2>
              <p class="text-muted">Dùng cho team marketing, studio, training.</p>
              <p class="fs-4 fw-bold text-primary">$39 / tháng</p>
              <ul class="list-unstyled text-muted">
                <li>✔️ License thương mại cho client</li>
                <li>✔️ Bộ deck trình chiếu & workshop kit</li>
                <li>✔️ Cập nhật hàng tuần + priority support</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card shadow-lg p-4">
        <% if (joined) { %>
        <div class="alert alert-success">
          ✅ Cảm ơn <strong><%= name %></strong> đã đăng ký gói <strong><%= plan %></strong>! Chúng tôi sẽ
          liên hệ qua email với hướng dẫn chi tiết.
        </div>
        <% } else { %>
        <h3 class="h5">Đăng ký ngay</h3>
        <form method="post">
          <div class="mb-3">
            <label class="form-label">Tên của bạn</label>
            <input class="form-control" name="name" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" name="email" type="email" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Gói</label>
            <select class="form-select" name="plan" required>
              <option value="Starter">Starter - $19/tháng</option>
              <option value="Agency">Agency - $39/tháng</option>
            </select>
          </div>
          <button class="btn btn-primary w-100" type="submit">Tham gia ngay</button>
        </form>
        <% } %>
        <div class="mt-4">
          <small class="text-muted">
            Toàn bộ dữ liệu được lưu an toàn. Bạn sẽ nhận email hướng dẫn sau khi đăng ký.
          </small>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>

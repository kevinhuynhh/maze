<%- include('partials/header', { isAdmin }) %>
<section class="container py-5">
  <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
      <div class="section-heading mb-2">Thư viện prompt</div>
      <h1 class="h3 fw-bold mb-1">Tất cả sản phẩm được phát hành bởi admin</h1>
      <p class="text-muted mb-0">Chuẩn hoá nội dung, không phải marketplace đại trà.</p>
    </div>
    <form class="d-flex" role="search" method="get">
      <input
        class="form-control me-2"
        type="search"
        placeholder="Tìm kiếm prompt"
        aria-label="Search"
        name="q"
        value="<%= q %>"
      />
      <button class="btn btn-primary" type="submit">Tìm</button>
    </form>
  </div>
  <div class="row g-4">
    <% if (products.length === 0) { %>
    <div class="col-12">
      <div class="alert alert-info">Không tìm thấy prompt phù hợp.</div>
    </div>
    <% } %>
    <% products.forEach((product) => { %>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-img-top bg-cover" style="background-image: url('<%= product.coverImage %>')">
          <div class="card-badge"><%= product.category %></div>
        </div>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= product.title %></h5>
          <p class="card-text text-muted flex-grow-1"><%= product.description %></p>
          <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="price-tag"><span class="amount">$<%= product.price.toFixed(2) %></span><span class="unit">/ bộ</span></div>
            <a class="btn btn-outline-primary btn-sm" href="/products/<%= product.id %>">Xem chi tiết</a>
          </div>
        </div>
      </div>
    </div>
    <% }); %>
  </div>
</section>
<%- include('partials/footer') %>

<%- include('partials/header', { isAdmin }) %>
<section class="bg-light py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6">
        <p class="badge text-bg-warning text-dark">Chỉ admin đăng bán</p>
        <h1 class="display-5 fw-bold">Cửa hàng prompt in ấn & membership chuyên sâu</h1>
        <p class="lead text-secondary">
          Build nhanh workshop, workbook và bộ prompt chất lượng cao. Không phải marketplace, chỉ
          admin được phép đăng sản phẩm để đảm bảo chất lượng nội dung.
        </p>
        <div class="d-flex gap-3 mt-3">
          <a class="btn btn-primary btn-lg" href="/products">Khám phá prompt</a>
          <a class="btn btn-outline-dark btn-lg" href="/membership">Xem Membership</a>
        </div>
      </div>
      <div class="col-md-6 text-center mt-4 mt-md-0">
        <div class="hero-card shadow-sm p-4 rounded-4 bg-white">
          <p class="text-muted mb-1">Tác vụ phổ biến</p>
          <ul class="list-unstyled mb-0">
            <li class="d-flex align-items-center mb-2">
              <span class="badge bg-primary me-2">PDF</span> Bộ prompt in ấn cho workshop
            </li>
            <li class="d-flex align-items-center mb-2">
              <span class="badge bg-success me-2">Template</span> Planner, worksheet, keynote deck
            </li>
            <li class="d-flex align-items-center mb-2">
              <span class="badge bg-info me-2">AI</span> Prompt gợi ý storytelling, sales, product
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold">Prompt nổi bật</h2>
    <a href="/products" class="text-decoration-none">Xem tất cả &rarr;</a>
  </div>
  <div class="row g-4">
    <% products.forEach((product) => { %>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-img-top bg-cover" style="background-image: url('<%= product.coverImage %>')">
          <div class="card-badge"><%= product.category %></div>
        </div>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= product.title %></h5>
          <p class="card-text text-muted flex-grow-1"><%= product.description %></p>
          <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold">$<%= product.price.toFixed(2) %></span>
            <a href="/products/<%= product.id %>" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<section class="bg-dark text-white py-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-md-6">
        <h2 class="h3 fw-bold">Membership cho workshop & agency</h2>
        <p class="text-white-50">
          Truy cập toàn bộ thư viện prompt printable, template workshop và cập nhật hàng tuần. Dùng
          cho team nội bộ, brand kit hoặc sản phẩm đào tạo nhanh.
        </p>
        <ul class="list-unstyled text-white-50">
          <li>✔️ Cập nhật prompt mới mỗi tuần</li>
          <li>✔️ Giấy phép sử dụng thương mại trong agency</li>
          <li>✔️ Bộ tài liệu print-ready và file gốc</li>
        </ul>
        <a href="/membership" class="btn btn-warning text-dark fw-semibold">Tham gia membership</a>
      </div>
      <div class="col-md-6">
        <div class="card shadow-lg text-dark">
          <div class="card-body">
            <h3 class="h4">Lý do không phải marketplace?</h3>
            <p class="mb-1">- Admin kiểm duyệt và phát hành, giữ tiêu chuẩn cao.</p>
            <p class="mb-1">- Nội dung thống nhất: PDF, slide, notion template, workbook.</p>
            <p class="mb-1">- Kênh hỗ trợ trực tiếp với team biên tập.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>

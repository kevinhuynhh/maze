<%- include('partials/header', { isAdmin }) %>
<section class="hero-section py-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-md-6">
        <div class="section-heading mb-3">Cửa hàng curated • Admin kiểm duyệt</div>
        <h1 class="display-5 fw-bold mb-3">Prompt printable & membership được biên tập đẹp mắt</h1>
        <p class="lead text-secondary">
          Workshop kit, workbook, bộ prompt AI và template trình chiếu – xuất bản bởi team admin để đảm
          bảo chất lượng, không phải marketplace đại trà.
        </p>
        <div class="d-flex gap-3 mt-3">
          <a class="btn btn-primary btn-lg px-4" href="/products">Khám phá prompt</a>
          <a class="btn btn-outline-dark btn-lg px-4" href="/membership">Xem Membership</a>
        </div>
        <div class="d-flex gap-2 mt-4 flex-wrap">
          <span class="stat-pill">✨ 120+ file print-ready</span>
          <span class="stat-pill">🛡️ Chỉ admin đăng bán</span>
          <span class="stat-pill">🚀 Update hàng tuần</span>
        </div>
      </div>
      <div class="col-md-6 mt-3 mt-md-0">
        <div class="hero-card shadow-sm p-4 rounded-4 bg-white">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <p class="text-muted mb-0">Tác vụ phổ biến</p>
            <span class="badge text-bg-warning text-dark">Print-ready</span>
          </div>
          <ul class="list-unstyled mb-0 feature-list">
            <li><span class="badge bg-primary">PDF</span> Bộ prompt workshop, coaching, đào tạo</li>
            <li><span class="badge bg-success">Template</span> Planner, worksheet, keynote / slides</li>
            <li><span class="badge bg-info text-dark">AI</span> Storytelling, sales, product, marketing</li>
          </ul>
          <div class="gradient-card mt-4 p-3 d-flex align-items-center justify-content-between">
            <div>
              <div class="fw-bold">Không phải marketplace</div>
              <small class="text-muted">Chuẩn hóa nội dung, hỗ trợ trực tiếp từ admin.</small>
            </div>
            <span class="badge bg-dark">Premium</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Prompt nổi bật</h2>
    <a href="/products" class="text-decoration-none fw-semibold">Xem tất cả &rarr;</a>
  </div>
  <div class="row g-4">
    <% products.forEach((product) => { %>
    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-img-top bg-cover" style="background-image: url('<%= product.coverImage %>')">
          <div class="card-badge"><%= product.category %></div>
        </div>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= product.title %></h5>
          <p class="card-text text-muted flex-grow-1"><%= product.description %></p>
          <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="price-tag"><span class="amount">$<%= product.price.toFixed(2) %></span><span class="unit">/ bộ</span></div>
            <a href="/products/<%= product.id %>" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<section class="bg-dark text-white py-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-md-6">
        <div class="section-heading mb-3 text-dark bg-white">Membership cho workshop & agency</div>
        <h2 class="h3 fw-bold">Thư viện trọn đời cho team của bạn</h2>
        <p class="text-white-50">
          Truy cập toàn bộ prompt printable, template workshop và cập nhật hàng tuần. Dùng cho team nội
          bộ, brand kit hoặc sản phẩm đào tạo nhanh.
        </p>
        <ul class="list-unstyled text-white-50 feature-list mb-4">
          <li>✔️ Cập nhật prompt mới mỗi tuần</li>
          <li>✔️ Giấy phép sử dụng thương mại trong agency</li>
          <li>✔️ Bộ tài liệu print-ready và file gốc</li>
        </ul>
        <a href="/membership" class="btn btn-warning text-dark fw-semibold">Tham gia membership</a>
      </div>
      <div class="col-md-6">
        <div class="card shadow-lg text-dark">
          <div class="card-body">
            <h3 class="h5">Lý do không phải marketplace?</h3>
            <p class="mb-1">- Admin kiểm duyệt và phát hành, giữ tiêu chuẩn cao.</p>
            <p class="mb-1">- Nội dung thống nhất: PDF, slide, notion template, workbook.</p>
            <p class="mb-1">- Kênh hỗ trợ trực tiếp với team biên tập.</p>
            <div class="d-flex gap-3 mt-3 flex-wrap">
              <span class="stat-pill">Hỗ trợ 1-1</span>
              <span class="stat-pill">File gốc kèm</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
